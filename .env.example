# Copy to .env and replace every path with your own absolute Windows directory.
# Literal paths only; forward slashes and quotes support spaces. Do not commit .env.
# Run: pwsh -File scripts/preflight.ps1 -SkipDocker
# No private data is downloaded or created by Compose. See DOCKER-LOCAL.md.
SAVE_DIR=C:/Users/you/AppData/Local/Bellwright/Saved/SaveGames
UE4SS_LOG_DIR="C:/Program Files (x86)/Steam/steamapps/common/Bellwright/Bellwright/Binaries/Win64/ue4ss"
MAP_ASSETS_DIR=C:/your/private/map-assets
RESOURCE_ANALYSIS_DIR=C:/your/private/resource-analysis
# Optional: set to 0 for a randomly assigned loopback port in an isolated test project.
# COMPANION_PORT=8710
